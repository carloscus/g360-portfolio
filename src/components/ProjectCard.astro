---
import { categoryLabel } from '../lib/catalog';
import { withBase } from '../lib/site';
import type { CatalogRepo } from '../lib/types';

interface Props {
  repo: CatalogRepo;
}

const { repo } = Astro.props;
const detailHref = withBase(`/proyecto/${repo.slug}/`);
---

<article class="card" data-category={repo.category}>
  <div class="card-head">
    <h3 class="card-title"><a href={detailHref}>{repo.name}</a></h3>
    <span class="chip">{categoryLabel(repo.category)}</span>
  </div>
  <p class="card-desc">{repo.description ?? 'Sin descripción en el README del repo.'}</p>
  {
    repo.stack.length > 0 && (
      <ul class="stack-list" aria-label="Stack">
        {repo.stack.map((item) => (
          <li class="stack-item">{item}</li>
        ))}
      </ul>
    )
  }
  <div class="card-foot">
    <a href={detailHref}>Detalle →</a>
    {repo.url && <a href={repo.url} rel="noopener noreferrer">GitHub ↗</a>}
  </div>
</article>
